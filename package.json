{
  "name": "dogpolicies-mcp",
  "version": "0.4.1",
  "description": "MCP server for verified dog rules at California and Nevada parks, beaches, trails, hotels, campgrounds and restaurant patios: leash rules, pet fees, weight limits, trip planning, every fact with its official source and the date it was checked.",
  "mcpName": "io.github.xultrax-web/dogpolicies-mcp",
  "type": "module",
  "license": "MIT",
  "author": "DogPolicies (https://dogpolicies.com)",
  "homepage": "https://github.com/xultrax-web/dogpolicies-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xultrax-web/dogpolicies-mcp.git",
    "directory": "packages/mcp"
  },
  "bugs": {
    "url": "https://github.com/xultrax-web/dogpolicies-mcp/issues"
  },
  "bin": {
    "dogpolicies-mcp": "bin/dogpolicies-mcp.mjs"
  },
  "exports": {
    ".": "./src/index.mjs",
    "./core": "./src/core/index.mjs",
    "./package.json": "./package.json"
  },
  "types": "./types/index.d.ts",
  "files": [
    "bin/",
    "src/",
    "types/",
    "data/snapshot.json.gz",
    "server.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs/"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node bin/dogpolicies-mcp.mjs check --offline",
    "demo": "node bin/dogpolicies-mcp.mjs demo --offline",
    "test": "node test/run.mjs",
    "test:e2e": "node test/run.mjs e2e",
    "inspect": "npx --yes @modelcontextprotocol/inspector --cli node bin/dogpolicies-mcp.mjs --offline --method tools/list",
    "prepack": "node scripts/prepack.mjs",
    "docs": "node scripts/docs.mjs",
    "contracts": "node scripts/contracts.mjs",
    "eval": "node --test test/eval.test.mjs",
    "format": "prettier --write .",
    "mcpb": "node scripts/mcpb.mjs",
    "icon": "node scripts/icon.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "prettier": "^3.9.10"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "modelcontextprotocol",
    "claude",
    "cursor",
    "ai-agent",
    "llm-tools",
    "dog-friendly",
    "pet-friendly",
    "pet-policy",
    "dogs",
    "travel",
    "hotels",
    "beaches",
    "parks",
    "camping",
    "california",
    "nevada",
    "open-data",
    "cc-by"
  ]
}
